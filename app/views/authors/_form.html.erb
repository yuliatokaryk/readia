<section class="card max-w-md">
  <%= form_with(model: author, html: { class: "flex flex-col gap-4" }) do |form| %>
    <% if author.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(author.errors.count, "error") %> prohibited this author from being saved:</h2>

        <ul>
          <% author.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
      
    <div class="field">
      <%= form.label :first_name, class: "label" %>
      <%= form.text_field :first_name, class: "input" %>
    </div>
  
    <div class="field">
      <%= form.label :last_name, class: "label" %>
      <%= form.text_field :last_name, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :portrait, class: "label" %>
      <%= form.file_field :portrait, class: "input" %>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-300" id="file_input_help">SVG, PNG or JPG</p>
    </div>

    <%= form.submit class: "btn btn-primary btn-md" %>
  <% end %>
</section>
