<div id="<%= dom_id author %>">
  <div class="card">
    <div class=".card-horizontal">
      <% if author.portrait.attached? %>
        <%= image_tag author.portrait %>
      <% else %>
        <%= image_tag "author-portrait-default.jpg" %>
      <% end %>
    </div>
    <h3 class="card-header"><%= link_to author.full_name, author %></h3>
    <% if author.user == current_user %>
      <span class="badge badge-success">
        Added by you
      </span>
    <% end %>
  </div>
</div>
