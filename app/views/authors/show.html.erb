<%= render @author %>

<div class=" flex flex-wrap gap-2">
  <% if policy(@author).update? %>
    <%= link_to "Edit this author", edit_author_path(@author), class: "btn btn-primary btn-md" %>
  <% end %>

  <% if policy(@author).destroy? %>
    <%= button_to "Destroy this author", @author, method: :delete, class: "btn btn-danger btn-md"%>
  <% end %>
</div>
