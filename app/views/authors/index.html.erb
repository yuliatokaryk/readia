<% content_for :title, "Authors" %>

<h2 class="font-serif text-lg font-semibold tracking-tight text-neutral-900">Authors</h2>

<div id="authors">
  <div class="space-y-4">
    <div class="grid md:grid-cols-2 gap-4">
      <% @authors.each do |author| %>
        <%= render author %>
      <% end %>
    </div>
  </div>
</div>
