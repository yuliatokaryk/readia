<div id="<%= dom_id list %>">
  <div class="card mt-3">
    <h2 class="card-header"><%= list.name %></h2>
    <p class="card-body">
      <%= list.books.count %> book(s) added to this list
    </p>
    <div class="card-footer flex flex-wrap gap-2">
      <%= link_to "Show this list", list, class: "btn btn-primary btn-md" %>
    </div>
  </div>
</div>
