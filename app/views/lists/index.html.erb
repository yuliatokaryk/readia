<% content_for :title, "Lists" %>

<h2 class="font-serif text-lg font-semibold tracking-tight text-neutral-900">Lists</h2>

<div id="lists">
  <% @lists.each do |list| %>
    <div class="card mt-3">
      <%= render list %>
      <div class="card-footer flex flex-wrap gap-2">
        <%= link_to "Show this list", list, class: "btn btn-primary btn-md" %>
      </div>
    </div>
  <% end %>
</div>
