<% content_for :title, "Editing list" %>

<h1 class="text-gray-900 sm:text-1xl md:text-3xl mb-2">Editing list</h1>

<%= render "form", list: @list %>

<br>

<div>
    <%= link_to "Show this list", @list, class: "bg-green-500 hover:bg-green-700 text-white py-1 px-2 border border-green-700 rounded" %>
    <%= link_to "Back to list", lists_path, class: "bg-transparent hover:bg-blue-500 text-blue-700 hover:text-white py-1 px-2 border border-blue-500 hover:border-transparent rounded" %>
</div>
