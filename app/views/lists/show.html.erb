<div class="card mt-3">
  <%= render @list %>

  <div class="flex flex-wrap gap-2 mt-3">
    <% if policy(@list).update? %>
      <%= link_to "Edit this list", edit_list_path(@list), class: "btn btn-primary btn-md" %>
    <% end %>

    <% if policy(@list).destroy? %>
      <%= button_to "Destroy this list", @list, method: :delete, class: "btn btn-danger btn-md"%>
    <% end %>

    <%= link_to "Back to all lists", lists_path, class: "btn btn-secondary btn-md" %>
  </div>

  <div class="card-footer">
    <% if @list.books.any? %>
      <div class="my-3">
        <h2 class="text-lg font-semibold text-gray-900">
          Books in this list:
        </h2>

        <ul class="space-y-2">
          <% @list.books.each do |book| %>
            <li><%= link_to book.title, book_path(book), class: "block rounded-lg px-4 py-3 text-sm font-medium text-gray-700 transition hover:bg-brand-50" %></li>
          <% end %>
        </ul>
    <% else %>
        <p class="mt-5 text-sm text-gray-500"> You don't have any books in this list yet. </p>
        <%= link_to "Browse books", books_path, class: "btn btn-primary btn-md" %>
      </div>
    <% end %>
  </div>
</div>



