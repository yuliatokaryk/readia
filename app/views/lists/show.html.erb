<div class="max-w-sm mx-auto bg-white rounded-lg shadow-sm border border-gray-200 p-4  my-3">
  <%= render @list %>
  <div class="my-5">
    <% if policy(@list).update? %>
      <%= link_to "Edit this list", edit_list_path(@list), class: "bg-green-500 hover:bg-green-700 text-white py-1 px-2 border border-green-700 rounded" %>
    <% end %>

    <%= link_to "Back to lists", lists_path, class: "bg-transparent hover:bg-blue-500 text-blue-700 hover:text-white py-1 px-2 border border-blue-500 hover:border-transparent rounded" %>
  </div>

  <% if policy(@list).destroy? %>
    <%= button_to "Destroy this list", @list, method: :delete, class: "bg-red-500 hover:bg-red-700 text-white py-1 px-2 border border-red-700 rounded"%>
  <% end %>

  <% if @list.books.any? %>
    <div class="my-4">
      <h2 class="text-lg font-semibold text-gray-900">
        Books in this list:
      </h2>

      <ol class="space-y-2">
        <% @list.books.each do |book| %>
          <li><%= link_to book.title, book_path(book), class: "block rounded-lg px-4 py-3 text-sm font-medium text-gray-700 transition hover:bg-blue-50 hover:text-blue-700" %></li>
        <% end %>
      </ol>
  <% else %>
    <p class="mt-5 text-sm text-gray-500"> You don't have any books in this list yet. </p>
    <%= link_to "Browse books", books_path, class: "mt-3 inline-block text-sm font-medium text-blue-600 hover:text-blue-700" %>
    </div>
  <% end %>
</div>
