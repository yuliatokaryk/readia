<section class="space-y-2">
  <div class="card">
    <div class="card-media">
        <% if @book.cover.attached? %>
          <%= image_tag @book.cover %>
        <% else %>
          <%= image_tag "book-cover-default.jpg" %>
        <% end %>
    </div>
    <h3 class="card-header"><%= link_to @book.title, @book %></h3>
    <div class="card-meta flex items-center gap-3">
      <span>by       
        <% if @book.author %>
          <%= @book.author.full_name %>
        <% else %>
          Unknown
        <% end %>
      </span>
    </div>
    <p class="card-body">
      Every reader hits a stretch where nothing lands. The stack by the bed stops looking
      inviting and starts looking like homework, and the obvious conclusion — that you have
      somehow stopped being a person who reads — is the one thing that is definitely not true.
    </p>

    <% if user_signed_in? %>
        <% user_lists_for_book = @book.lists.where(user: current_user) %>

        <% if user_lists_for_book.any? %>
          <div class="mt-3">
            <span class="badge badge-warning" >
              Added to list: <%= user_lists_for_book.map(&:name).join(", ") %>
            </span>
          </div>
        <% end %>

      <div class="card-body flex flex-wrap items-center gap-2 mt-4">
        <% if policy(@book).update? %>
          <%= link_to edit_book_path(@book), class: "btn btn-secondary btn-md flex items-center gap-2" do %>
            <svg class="icon icon-sm" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
            </svg>
            Edit
          <% end %>
        <% end %>

        <% if policy(@book).destroy? %>
          <%= button_to @book, method: :delete, class: "btn btn-danger btn-md" do %>
            <svg class="icon icon-sm" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
            Delete
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="card-footer space-y-4">
      <div class="flex items-center gap-2">
        <h4 class="card-header mb-0 text-base">Reviews</h4>
        <span class="badge badge-brand"><%= @reviews.count %></span>
      </div>

      <% if @reviews.any? %>
        <div class="comment-list">
          <% @reviews.each do |review| %>
            <div class="comment">
              <%= image_tag "author-portrait-default.jpg", class: "avatar size-8 shrink-0 grid place-items-center bg-neutral-200 text-xs font-semibold text-neutral-700" %>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline gap-2">
                  <span class="comment-author"><%= review.user.email %></span>
                  <% if review.published == true %>
                    <span class="comment-meta"><%= review.created_at %></span>
                  <% else %>
                    <span class="comment-meta">Saved as a draft</span>
                  <% end %>
                </div>
                <p class="comment-body">
                  <%= review.body %>
                </p>
                <div class="flex flex-wrap items-baseline gap-2">
                  <% if policy(review).update? %>
                    <%= link_to "Edit", edit_book_review_path(@book), class: "comment-meta" %>
                  <% end %>
                  <%= button_to book_review_path(@book, review),
                      method: :delete,
                      class: "comment-meta" do %>
                      Delete
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if user_signed_in? %>
        <%= render "reviews/form", book: @book, review: @review %>
      <% end %>
    </div>
</section>
