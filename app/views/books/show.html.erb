<%= render @book %>

<div class=" flex flex-wrap gap-2">
<% if policy(@book).update? %>
  <%= link_to "Edit this book", edit_book_path(@book), class: "btn btn-primary btn-md" %>
<% end %>

<% if policy(@book).destroy? %>
  <%= button_to "Destroy this book", @book, method: :delete, class: "btn btn-danger btn-md"%>
<% end %>
