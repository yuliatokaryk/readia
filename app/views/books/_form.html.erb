<section class="card max-w-md">
  <%= form_with(model: book, html: { class: "flex flex-col gap-4" }) do |form| %>
    <% if book.errors.any? %>
      <div style="color: red">
        <h2><%= pluralize(book.errors.count, "error") %> prohibited this book from being saved:</h2>

        <ul>
          <% book.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
      
    <div class="field">
      <%= form.label :title, class: "label" %>
      <%= form.text_field :title, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :author_id, class: "label" %>
      <%= form.collection_select :author_id, Author.all, :id, :full_name,
        { prompt: "Select an author" },
        { class: "input" } %>
    </div>
  
    <div class="field">
      <%= form.label :published_at, class: "label" %>
      <%= form.date_field :published_at, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :cover, class: "label" %>
      <%= form.file_field :cover, class: "input" %>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-300" id="file_input_help">SVG, PNG or JPG</p>
    </div>

    <%= form.submit class: "btn btn-primary btn-md" %>
  <% end %>
</section>
