<div id="<%= dom_id book %>">
  <div class="card card-horizontal mt-4">
    <div class="card-book-cover">
      <% if book.cover.attached? %>
        <%= image_tag book.cover %>
      <% else %>
        <%= image_tag "book-cover-default.jpg" %>
      <% end %>
    </div>
    <div>
      <div class="flex flex-wrap gap-2 mb-3">
        <% if book.user == current_user %>
          <span class="badge badge-success">
            Added by you
          </span>
        <% end %>

        <% user_lists_for_book = book.lists.where(user: current_user) %>

        <% if user_lists_for_book.any? %>
          <span class="badge badge-warning" >
            Added to list: <%= user_lists_for_book.map(&:name).join(", ") %>
          </span>
        <% end %>
      </div>

      <h3 class="card-header">
        <%= link_to book.title, book %>
      </h3>
      <p class="card-book-author">by
        <% if book.author %>
          <%= book.author.full_name %>
        <% else %>
          Unknown
        <% end %>
      </p>
      <p class="card-body">A high fantasy epic of ancient pacts and a kingdom built on dragonfire.</p>
      <% user_lists_for_book = book.lists.where(user: current_user) %>

      <% if user_signed_in? %>
        <%= form_with url: add_to_list_book_path(book), method: :post, class: "card-footer flex flex-col gap-3" do |form| %>
          <div class="field">
            <label class="label" for="book-shelf">Add to my list</label>
            <%= form.collection_select :list_id, current_user.lists, :id, :name, {}, class: "select" %>
          </div>
          <%= form.submit "Add to list", class: "btn btn-primary btn-md" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
