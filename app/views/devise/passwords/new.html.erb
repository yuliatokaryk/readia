<section class="card max-w-md">
  <h2 class="card-header">Forgot your password?</h2>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "flex flex-col gap-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="field">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "input" %>
    </div>

    <%= f.submit "Send me password reset instructions", class: "btn btn-primary btn-md" %>
  <% end %>
  <%= render "devise/shared/links" %>
</section>
