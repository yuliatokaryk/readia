<div id="sidebar-drawer" class="sidebar-drawer" data-ds-panel="drawer">
  <div class="sidebar-backdrop" data-ds-dismiss="drawer"></div>
  <aside class="sidebar">
    <div class="sidebar-section-title">Menu</div>
    <%= link_to "Books", books_path, class: "sidebar-link #{ sidebar_link_active_class(:books) }" %>
    <%= link_to "Authors", authors_path, class: "sidebar-link #{ sidebar_link_active_class(:authors) }" %>

    <% if user_signed_in? %>
      <%= link_to "Lists", lists_path, class: "sidebar-link #{ sidebar_link_active_class(:lists) }" %>
      <div class="sidebar-section-title">Account</div>
      <%= link_to "Profile", edit_user_registration_path, class: "sidebar-link #{ sidebar_link_active_class(:registrations) }" %>
      <div class="sidebar-footer">
        <p class="mb-2 truncate text-xs text-neutral-400"><%= current_user.email %></p>
        <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "sidebar-link" %>
      </div>
    <% else %>
      <div class="sidebar-footer">
        <%= link_to "Log in", new_user_session_path, class: "sidebar-link" %>
      </div>
    <% end %>
  </aside>
</div>

<button
  type="button"
  class="btn btn-primary btn-md sidebar-toggle"
  data-ds-toggle="drawer"
  aria-controls="sidebar-drawer"
  aria-expanded="false"
  aria-label="Toggle sidebar"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
  </svg>
</button>
